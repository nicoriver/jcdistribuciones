# ==============================================================================
# JC Distribuciones — Plantilla de Variables de Entorno (.env.example)
# Copie este archivo como '.env' en la raíz del proyecto para desarrollo local.
# En producción (VPS Linux), configure estas variables mediante systemd o archivo protegido.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración General de Django
# ------------------------------------------------------------------------------
# Clave secreta (en producción DEBE ser una clave aleatoria y segura, sin prefijo 'django-insecure-')
DJANGO_SECRET_KEY=django-insecure-key-jc-distribuciones-change-in-production

# Modo depuración (True para desarrollo local; False OBLIGATORIO en producción)
DJANGO_DEBUG=True

# Dominios / IPs permitidos separados por coma (ej: 'distribuidora.ejemplo.com,127.0.0.1')
# En producción está prohibido el comodín '*'
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes completos permitidos para CSRF sobre HTTPS (separados por coma)
# Ej: https://distribuidora.ejemplo.com,https://portal.distribuidora.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------------------
# Configuración de Base de Datos
# ------------------------------------------------------------------------------
# Motor de base de datos: 'sqlite' (desarrollo local) o 'postgresql' (VPS producción)
DB_ENGINE=sqlite

# Parámetros para PostgreSQL (obligatorios cuando DB_ENGINE=postgresql)
DB_NAME=jcdistribuciones
DB_USER=postgres
DB_PASSWORD=postgres_password_ejemplo
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Opciones de Proxy Inverso y HTTPS (solo en producción con Nginx y certificado SSL)
# ------------------------------------------------------------------------------
# DJANGO_SECURE_PROXY_SSL_HEADER=False
# DJANGO_SECURE_SSL_REDIRECT=False
